{
  "name": "chaewoon",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:front": "pnpm --filter chaewoon-front dev",
    "dev:backend": "pnpm --filter chaewoon-backend start:dev",
    "build": "pnpm -r build",
    "build:front": "pnpm --filter chaewoon-front build",
    "build:backend": "pnpm --filter chaewoon-backend build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}